# Bearer token for this station; mint with `just station-add`
STATION_TOKEN=

# Postgres password for the compose service (any random string)
POSTGRES_PASSWORD=
# Host-side URL for `just migrate`, `go run`, and psql; must use the same password
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/listening_post

# KRaft cluster id; generate once per environment and never change it:
#   docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=
